{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/spec", "destination": "/specification", "permanent": false },
    { "source": "/cert", "destination": "/certification", "permanent": false },
    { "source": "/dev",  "destination": "/developer",     "permanent": false },
    { "source": "/gov",  "destination": "/governance",    "permanent": false }
  ]
}
